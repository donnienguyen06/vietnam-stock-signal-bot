# Copy to project .env on the SERVER. Never share the actual .env.
# Set a DNS A record for this hostname pointing to the VPS first.
DOMAIN=bot.example.com
ADMIN_USERNAME=admin
# Generate a random password of at least 20 characters.
ADMIN_PASSWORD=
# SSI FastConnect Data credentials (required for SSI realtime; keep private)
SSI_CONSUMER_ID=
SSI_CONSUMER_SECRET=
SSI_BASE_URL=https://fc-data.ssi.com.vn/
SSI_STREAM_URL=https://fc-datahub.ssi.com.vn/
# Configure Telegram using the HTTPS dashboard after deployment.
